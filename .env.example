# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Kaltura partner/account id
AGENTIC_PARTNER_ID=

# Kaltura admin secret — server-side only, never sent to the browser.
AGENTIC_ADMIN_SECRET=

# The Jetson Xavier tutor agent's id (from Kaltura Management), if already provisioned.
AGENTIC_AGENT_ID=
